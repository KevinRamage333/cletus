# =============================================================================
# CLETUS — environment configuration
# Copy to .env.local (dev) or set as host secrets (prod). Never commit real values.
# Resolution order: defaults -> AGGRESSION_LEVEL -> TRADING_PRESET -> explicit vars below.
# =============================================================================

# ---- Mode & safety -----------------------------------------------------------
# simulation = paper trading on live market data, NOTHING is signed (default)
# live       = real swaps via Jupiter; requires a wallet key below
TRADING_MODE=simulation
# Beta mode: per-user paper accounts; forces simulation unless ALLOW_LIVE_IN_BETA=true
BETA_MODE=true
ALLOW_LIVE_IN_BETA=false
ENABLE_KILL_SWITCH=true
# Run the UI without the trading loop:
# ENGINE_DISABLED=true

# ---- Secrets (server-only) ----------------------------------------------------
# Operator trading wallet: EITHER a base58 / JSON-array secret key...
TRADING_WALLET_PRIVATE_KEY=
# ...OR a path to a solana-keygen JSON file (preferred locally; chmod 600)
TRADING_WALLET_KEYPAIR_PATH=./.secrets/trading-wallet.json
# Helius RPC (recommended for live). Falls back to RPC_URL, then public mainnet RPC.
HELIUS_RPC_URL=
RPC_URL=https://api.mainnet-beta.solana.com
# Jupiter Swap API V2 (https://api.jup.ag/swap/v2: GET /order + POST /execute) and Price API V3.
# Key from https://developers.jup.ag/portal, sent as x-api-key. Empty = keyless (0.5 RPS); free key = 1 RPS.
# Limits are per organisation, 60 s sliding window; /execute has its own bucket (keyless 20 RPS, free 50 RPS).
JUPITER_API_KEY=
# Override the client-side rate limits if you upgrade your Jupiter plan (requests/second):
# JUPITER_RPS=1
# JUPITER_EXECUTE_RPS=50
# Simulation fills use keyless /order quotes (no taker) for real impact + feeBps; set off to use the pool model only
# SIM_JUPITER_QUOTES=on
# Operator / platform fee on each swap (Jupiter Swap API V2 referral program).
# 50 bps = 0.5% ($0.50 on a $100 swap). Jupiter keeps 20% of this fee and charges no separate platform fee
# when referral is active. Range 50–255, or 0 to disable. See docs/OPERATOR_FEE.md for the one-time
# referral-account setup. Collection does not start until JUPITER_REFERRAL_ACCOUNT is set.
# OPERATOR_FEE_WALLET defaults to PAYOUT_WALLET when PAYOUT_WALLET is set and this is empty.
# Create the Jupiter referral account by connecting PAYOUT_WALLET at https://referral.jup.ag/dashboard-ultra
# (do not invent a referral account address). Owner trades from the trading wallet are not charged.
# OPERATOR_FEE_WALLET=
OPERATOR_FEE_BPS=50
OPERATOR_FEE_ON_OWNER=false
# On-chain Jupiter referral account (NOT the same as PAYOUT_WALLET / OPERATOR_FEE_WALLET). Leave empty until created.
# JUPITER_REFERRAL_ACCOUNT=
# Optional RugCheck key (public endpoint works without one)
# RugCheck via FluxRPC: the key is sent as X-API-KEY (free plan: 3 req/s). The base defaults to https://api.rugcheck.xyz/v1;
# a ?key= in RUGCHECK_API_URL is stripped and used as the key. The Shield key is FluxRPC's public/browser key, tried only if the
# API key is rejected. Everything falls back to the public endpoint.
RUGCHECK_API_KEY=
RUGCHECK_API_URL=
RUGCHECK_SHIELD_KEY=
# Brain provider: ONE switch. gemini (default, free tier) | xai | mock.
# Fallback chain is preferred -> the other -> offline mock.
BRAIN_PROVIDER=gemini
# Gemini (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_AI_BRAIN=true
# Database: PostgreSQL (schema=app, SSL required). `npm run db:init` generates the CLETUS_*_PW role passwords
# and writes all four URLs below into .env.local (chmod 600). Never commit real values.
DATABASE_URL=
MARKET_DATA_DATABASE_URL=
LLC_DATABASE_URL=
BACKUP_DATABASE_URL=
CLETUS_APP_PW=
CLETUS_MD_PW=
CLETUS_LLC_PW=
CLETUS_BACKUP_PW=
# Optional SQLite dev mode (npm run db:sqlite): DATABASE_URL="file:./dev.db"
SQLITE_DATABASE_URL="file:./dev.db"
# Optional: CA file to verify the Postgres server cert (otherwise encrypted, not CA-verified)
PG_SSL_CA=
# market_data collector (1m candles via GeckoTerminal; shares the GECKO_RPM budget with charts)
MARKET_DATA_COLLECTOR=on
MARKET_DATA_TICK_SECONDS=60
MARKET_DATA_POOLS_PER_TICK=2
MARKET_DATA_POOL_INTERVAL_SECONDS=300
MARKET_DATA_MAX_POOLS=20
MARKET_DATA_CANDLES_PER_FETCH=100
# Backups (scripts/db-backup.sh): age public key file, output dir, optional off-box upload command
BACKUP_AGE_RECIPIENTS=.secrets/backup-age.pub
BACKUP_DIR=
BACKUP_OFFSITE_CMD=
# Session signing secret, >= 32 random chars (openssl rand -hex 32). REQUIRED in production.
SESSION_SECRET=

# ---- Beta access --------------------------------------------------------------
# Require this code at sign-up:
# BETA_INVITE_CODE=
# BETA_ALLOWED_EMAILS=a@x.com,b@y.com
# If empty, the first user to sign up is admin:
# ADMIN_EMAILS=you@x.com
# Bump + rebuild to force everyone to re-accept terms & risk:
# NEXT_PUBLIC_TERMS_VERSION=2026-11-11.4

# ---- Preset & aggression ------------------------------------------------------
# Presets: CONSERVATIVE_EARNER | DAY_TRADER | NIGHT_TRADER | ALPHA_HUNTER_24_7 | WEEKEND_WARRIOR | NONE
# In live mode with no preset set, CONSERVATIVE_EARNER is applied.
TRADING_PRESET=
# CONSERVATIVE | MODERATE | AGGRESSIVE | MAXIMUM  (live default: CONSERVATIVE, sim default: MODERATE)
AGGRESSION_LEVEL=
# Per-level overrides follow <LEVEL>_<PARAM>, e.g. CONSERVATIVE_MIN_COMPOSITE_SCORE=0.75
# Level table defaults:            CONS   MOD    AGGR   MAX
#   MIN_COMPOSITE_SCORE            0.75   0.65   0.55   0.45
#   MAX_POSITION_SIZE_USD          1000   5000   15000  50000
#   MAX_OPEN_POSITIONS             2      5      10     20
#   SLIPPAGE_TOLERANCE             0.02   0.05   0.10   0.20
#   PRIORITY_FEE_LAMPORTS          50000  100000 200000 500000
#   TRADE_FREQUENCY_SECONDS        300    120    60     30
#   MIN_VOLUME_USD                 10000  5000   2000   1000
#   HOLD_TIME_MINUTES              120    60     30     10
# Direct overrides (win over level + preset):
# MIN_COMPOSITE_SCORE= MAX_POSITION_SIZE_USD= MAX_OPEN_POSITIONS= SLIPPAGE_TOLERANCE=
# PRIORITY_FEE_LAMPORTS= TRADE_FREQUENCY_SECONDS= HOLD_TIME_MINUTES= MIN_VOLUME_USD=
# Exit checks poll open-position prices this often (default 3, min 2) so stops don't gap far past their level
POSITION_MONITOR_SECONDS=3

# ---- Operating schedule -------------------------------------------------------
ENABLE_24_7_TRADING=false
TRADING_START_TIME=09:00
TRADING_END_TIME=17:00
# 0=Monday ... 6=Sunday
TRADING_DAYS=0,1,2,3,4
TRADING_TIMEZONE=America/New_York
PAUSE_ON_WEEKENDS=true

# ---- Exits --------------------------------------------------------------------
STOP_LOSS_PERCENTAGE=10.0
TAKE_PROFIT_PERCENTAGE=25.0
BREAK_EVEN_TRIGGER_PERCENTAGE=5.0
ENABLE_TRAILING_STOP=true
TRAILING_STOP_PERCENTAGE=5.0

# ---- PnL targets & limits (USD) -------------------------------------------------
DAILY_PNL_TARGET=5000
DAILY_LOSS_LIMIT=-2000 # Set to 0 to disable the dollar cap
WEEKLY_PNL_TARGET=30000
WEEKLY_LOSS_LIMIT=-10000
MONTHLY_PNL_TARGET=100000
MONTHLY_LOSS_LIMIT=-30000

# ---- Progressive sizing tiers (by cumulative realized PnL) -----------------------
TIER_1_PNL_THRESHOLD=0
TIER_1_CLIP_MULTIPLIER=1.0
TIER_2_PNL_THRESHOLD=10000
TIER_2_CLIP_MULTIPLIER=1.5
TIER_3_PNL_THRESHOLD=20000
TIER_3_CLIP_MULTIPLIER=2.0
TIER_4_PNL_THRESHOLD=40000
TIER_4_CLIP_MULTIPLIER=2.5
TIER_5_PNL_THRESHOLD=60000
TIER_5_CLIP_MULTIPLIER=3.0

# ---- Drawdown & recovery ----------------------------------------------------------
MAX_DRAWDOWN_PERCENTAGE=15.0
ENABLE_RECOVERY_MODE=true
RECOVERY_MODE_AGGRESSION_MULTIPLIER=0.5
RECOVERY_MODE_EXIT_WINS=5

# ---- Signals & self-learning --------------------------------------------------------
ENABLE_DYNAMIC_SIGNAL_WEIGHTING=false # Optional; only confirmed live closes can update weights
SIGNAL_VOLUME_SPIKE_WEIGHT=0.15
SIGNAL_MOMENTUM_WEIGHT=0.15
SIGNAL_BREAKOUT_WEIGHT=0.12
SIGNAL_VELOCITY_SURGE_WEIGHT=0.12
SIGNAL_MICRO_CAP_HEAT_WEIGHT=0.15
SIGNAL_NANO_CAP_SPIKE_WEIGHT=0.12
SIGNAL_LIQUIDITY_BUILD_WEIGHT=0.10
SIGNAL_VOL_MCAP_RATIO_WEIGHT=0.09
WIN_SIGNAL_AMPLIFY_FACTOR=1.15
LOSS_SIGNAL_DAMPEN_FACTOR=0.85
MIN_SIGNAL_WEIGHT=0.02
# Signal rule thresholds (from the spec)
# volume spike: 5m volume > 5% of market cap
VOLUME_SPIKE_5M_MCAP_PCT=5
# momentum breakout: > 5% price rise in 5m
BREAKOUT_5M_PRICE_PCT=5
# buy pressure: buys > 70% of 5m txns
BUY_PRESSURE_RATIO=0.7
NANO_CAP_MAX_USD=100000

# ---- Risk per trade -------------------------------------------------------------------
RISK_PER_TRADE_PERCENTAGE=2.0
MAX_TOTAL_EXPOSURE_PERCENTAGE=60.0
EQUITY_PROTECTION_LEVEL=10000
MIN_TRADE_USD=10

# ---- Scanner & market filters ------------------------------------------------------------
# Broad market regime: off | shadow | on. Shadow logs risk-off / disorderly-market blocks without enforcing them.
# Set on only after reviewing paper-trading results; blocks new entries in risk_off/high_volatility regimes.
MARKET_REGIME_GATE=shadow
# Market-cap band comes from MCAP_PRESET (see below). Uncomment to override it.
# MIN_MARKET_CAP=
# MAX_MARKET_CAP=
# Per-token minimum 24h volume in USD (fixed: the guide said "100,000,000 SOL")
MIN_MARKET_VOLUME_24H=10000
MIN_MARKET_VOLUME_5M=2000           # Minimum pool volume in USD over five minutes
MIN_TOKEN_AGE_HOURS=6
MAX_HOLDER_CONCENTRATION=0.30
MAX_HOURLY_PRICE_MOVEMENT=50.0
REQUIRE_LIQUIDITY_LOCK=true
MIN_LP_LOCKED_PCT=80
SCAN_TOP_N=25
AUDIT_TOP_N=6
SCAN_SEARCH_QUERIES=pump,pumpswap,raydium,meteora,solana

# ---- Pre-trade audit ---------------------------------------------------------------------
MAX_AUDIT_RISK_SCORE=69
MAX_SELL_PRICE_IMPACT_PCT=25

# ---- Execution & self-healing --------------------------------------------------------------
TX_CONFIRMATION_TIMEOUT=30
TX_RETRY_COUNT=3
PRIORITY_FEE_ESCALATION_FACTOR=1.5
MAX_PRIORITY_FEE_LAMPORTS=2000000
SLIPPAGE_WIDEN_STEP_BPS=100
MAX_SLIPPAGE_BPS=1000
MAX_CONSECUTIVE_FAILURES=3
FAILURE_PAUSE_MINUTES=15

# ---- Compliance gate (self-imposed market-conduct limits; not legal advice) ------------------
SEC_MAX_VOLUME_SHARE=0.05
SEC_MAX_LIQUIDITY_SHARE=0.02
SEC_WASH_TRADE_WINDOW_MINUTES=60
SEC_MAX_TRADES_PER_5MIN=8
SEC_DEFAULT_SOL_PRICE_USD=180

# ---- Simulation ------------------------------------------------------------------------------
SIM_STARTING_BALANCE_USD=10000
SIM_FEE_BPS=30

# ---------------------------------------------------------------------------
# Brain / news / journal
# ---------------------------------------------------------------------------
# Minutes between news + world-briefing refreshes (RSS, SOL price, DexScreener trending)
NEWS_REFRESH_MINUTES=30
# Set true to disable outbound news fetching entirely
NEWS_DISABLED=false
# ---------------------------------------------------------------------------
# xAI Grok (second Brain provider; OpenAI-compatible API, streaming + tool calling + web search)
# ---------------------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
# XAI_BASE_URL=https://api.x.ai/v1
# Set false to stop Grok from using server-side web_search for world events (RSS stays as backup)
XAI_WEB_SEARCH=true

# ---------------------------------------------------------------------------
# Gemini free-tier protection
# ---------------------------------------------------------------------------
GEMINI_MIN_INTERVAL_MS=6500        # ~9 requests/minute
GEMINI_DAILY_REQUEST_CAP=200       # stop before the free daily quota runs out
GEMINI_BACKOFF_BASE_MS=30000       # first 429 cool-down, doubles per strike
GEMINI_BACKOFF_MAX_MS=900000
NEWS_SUMMARY_CACHE_MINUTES=60      # reuse the last AI world briefing for this long
NEWS_SUMMARY_MIN_NEW_ITEMS=8       # ...unless this many new headlines arrived (min 15 min)
BRAIN_GOOGLE_SEARCH=true


# ---------------------------------------------------------------------------
# Owner live-trading money plan (operator / server wallet only)
# ---------------------------------------------------------------------------
# Progressive dollar sizing by wallet equity (USD, using the live SOL price):
#   under $10 → $3; $10–$20 → $5; $20–$30 → $7; then +$2 per additional $10.
# One open position, 5% stop-loss, 20% take-profit, Balanced market-cap band.
# Never sizes above equity minus a 0.01 SOL fee reserve (gas for the exit sell).
# Override the table with JSON if needed:
# OWNER_SIZE_TIERS=[{"minEquityUsd":0,"sizeUsd":3},{"minEquityUsd":10,"sizeUsd":5},{"minEquityUsd":20,"sizeUsd":7}]
# OWNER_SIZE_STEP_USD=10
# OWNER_SIZE_INCREMENT_USD=2
# OWNER_FEE_RESERVE_SOL=0.01
# OWNER_STOP_LOSS_PCT=5
# OWNER_TAKE_PROFIT_PCT=20
# OWNER_MAX_OPEN_POSITIONS=1
# OWNER_MIN_TRADE_USD=1
# OWNER_PLAN_ENABLED=true
#
# Profit-sweep ladder to the owner's payout wallet. Sweep is disabled until PAYOUT_WALLET is set
# AND PAYOUT_WALLET_CONFIRMED equals that same address. If the address later changes, the sweep
# pauses until it is re-confirmed. Sweeps only run when flat, send SOL, and never pay the same
# rung twice. Live sends also require TRADING_MODE=live (kept off until the owner says go).
# PAYOUT_WALLET=
# PAYOUT_WALLET_CONFIRMED=
# OWNER_SWEEP_AMOUNT_USD=25
# OWNER_SWEEP_STEP_USD=50
# OWNER_SWEEP_FIRST_TARGET_USD=50
# OWNER_SWEEP_DAILY_CAP_USD=50

# ---------------------------------------------------------------------------
# Market-cap presets and scanner filters
# ---------------------------------------------------------------------------
# DEGEN $10k-$500k | BALANCED $250k-$5M (default) | SAFER $5M-$50M
MCAP_PRESET=BALANCED
MIN_LIQUIDITY_USD=50000
MIN_VOLUME_MCAP_RATIO=0.2          # 24h volume must be >= 20% of market cap
MAX_TOP10_HOLDER_PCT=30            # top 10 non-pool holders combined
# Paper-only "preset lab" accounts trade all three presets side by side for the scorecard
ENABLE_PRESET_LAB=true

# ---------------------------------------------------------------------------
# Portfolio and hard risk limits
# ---------------------------------------------------------------------------
MAX_OPEN_POSITIONS=20
MAX_POSITION_PCT_OF_EQUITY=5       # per-position cap, % of wallet equity
MAX_POSITIONS_PER_CLUSTER=3        # per narrative (cats, dogs, AI...) or per dev wallet
EXIT_CONCURRENCY=8                 # open positions evaluated in parallel per tick
MAX_DAILY_LOSS_PCT=5               # in addition to DAILY_LOSS_LIMIT (USD)
MAX_CONSECUTIVE_LOSSES=4           # auto-pause the account after N losses in a row
DEV_SELL_CHECK=true
BLOCK_IF_DEV_EXITED=false          # strict: block tokens whose creator sold out within the lookback
DEV_EXIT_LOOKBACK_HOURS=24

# ---------------------------------------------------------------------------
# Exits
# ---------------------------------------------------------------------------
PARTIAL_TAKE_PROFITS=10:33,18:50   # at +10% sell 33% of what's left, at +18% sell 50%
STALE_POSITION_MINUTES=45          # close if still within +/-STALE_BAND_PCT after this long
STALE_BAND_PCT=2

# ---------------------------------------------------------------------------
# Live swap submission: Jupiter swaps are now landed by Swap API V2 POST /execute, so these settings no longer
# apply to swaps (still parsed and shown on the dashboard; unused by the executor).
# ---------------------------------------------------------------------------
SWAP_SUBMISSION_MODE=standard      # standard | private_rpc | jito
PRIVATE_RPC_URL=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# RPC: Helius primary (+ WebSocket for fast exits, DAS for holders), FluxRPC backup with automatic failover
# ---------------------------------------------------------------------------
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WS_URL=
# HELIUS_WS_DISABLED=false
# WS_EXIT_DEBOUNCE_MS=1000
FLUXRPC_API_KEY=
BACKUP_RPC_URL=
RPC_MAX_FAILURES=2          # consecutive errors/timeouts before failing over
RPC_MAX_LATENCY_MS=1500     # EWMA latency above this fails over
RPC_RECOVER_CHECKS=3        # healthy getHealth checks before switching back to Helius
RPC_HEALTH_INTERVAL_MS=20000

# ── Whale / smart-money flow (Helius Parsed Events, 10 credits per call) and X hype (X API v2) ──
# Collectors write to market_data (needs MARKET_DATA_DATABASE_URL). Both are confirmers/vetoes, never buy triggers.
HELIUS_FLOW_CREDITS_PER_DAY=10000      # daily Helius credit cap for flow tracking (~300k/month)
WHALE_MAX_POOLS=6                      # open positions + top candidates tracked
WHALE_POSITION_INTERVAL_SECONDS=300
WHALE_CANDIDATE_INTERVAL_SECONDS=600
WHALE_MIN_USD=1000                     # whale = max(this, 0.5% of pool liquidity)
WHALE_FAST_EXIT=on                     # close a position on a dev dump / smart-money or whale exit (off to disable)
SIGNAL_VETO_MODE=shadow                # shadow = log vetoes only; on = block entries; off
WATCHED_WALLETS=                       # owner wallets to watch: addr:label,addr2:label2 (or scripts/whales/add-wallet.ts)
X_BEARER_TOKEN=                        # X API v2 app bearer token (recent search + counts). Empty = X hype off
X_MAX_REQUESTS_PER_DAY=300
X_PER_TOKEN_INTERVAL_MIN=15
X_SEARCH_SAMPLE=50

# ---------------------------------------------------------------------------
# Owner desk (/owner) and public live feed (/live)
# ---------------------------------------------------------------------------
# Wallet that may sign in at /owner (SIWS). Defaults to PAYOUT_WALLET, then the
# registered Jupiter payout address. This is NOT the trading wallet.
# OWNER_WALLET=
# Shared secret for the box → Vercel snapshot / halt channel (>=16 chars).
# Falls back to SESSION_SECRET when unset. Set the same value on the box and on Vercel.
# OWNER_SNAPSHOT_SECRET=
# Override the Vercel ingest URL (default: production /api/internal/owner-snapshot). Set off to disable push.
# OWNER_SNAPSHOT_PUSH_URL=
# OWNER_STATE_PATH=data/owner-state.json
# LIVE_TRADES_PATH=logs/live-trades.jsonl
