generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

// Postgres (default): DATABASE_URL=postgresql://cletus_app:…@127.0.0.1:5432/cletus?schema=app&sslmode=require
// Tables live in the `app` schema (owned by role cletus_app). See docs/DATABASE_PLAN.md.
// SQLite fallback for quick local dev: `npm run db:sqlite` generates prisma/sqlite/schema.prisma
// from this file and pushes it to file:./dev.db (see README "Database").
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  isAdmin         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  ageAttestationVersion String?
  ageAttestedAt   DateTime?
  termsVersion    String?
  termsAcceptedAt DateTime?
  riskVersion          String?
  riskAckAt             DateTime?
  financialConsentVersion String?
  financialConsentAt    DateTime?
  walletPublicKey String?
  walletSource    String?      // "connected" | "paper" (legacy: "created" | "imported")
  walletSetupAt   DateTime?
  acceptances     Acceptance[]
  account         Account?
  feedback        Feedback[]
  conversations   Conversation[]
  displayName     String?
  bio             String?
  banned          Boolean      @default(false)
  trialStartedAt  DateTime?    // 30-day trial flag (informational; no billing)
  taxAckAt        DateTime?    // tax-responsibility acknowledgment (no tax IDs are collected)
  communityMessages CommunityMessage[]
  verificationRequests DeveloperVerification[]
  communityOptIn    CommunityOptIn?
  communityPosts    CommunityPost[]
  communityReports  CommunityReport[]
  @@schema("app")
}


// Immutable audit trail of every onboarding acceptance.
model Acceptance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "age-18+" | "terms" | "risk" | "wallet" | "financial-consent:<stage>"
  version   String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@schema("app")
}


model Account {
  id              String     @id @default(cuid())
  userId          String?    @unique
  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  isOperator      Boolean    @default(false)
  labPreset       String?    @unique // paper-only preset-comparison account (DEGEN | BALANCED | SAFER)
  startingBalance Float
  cashUsd         Float
  realizedPnl     Float      @default(0)
  peakEquity      Float
  paused          Boolean    @default(false)
  pauseReason     String?
  recoveryMode    Boolean    @default(false)
  consecutiveWins Int        @default(0)
  consecutiveLosses Int      @default(0)
  settings        String?    // JSON AccountSettings from the Config page (src/lib/user-settings.ts)
  createdAt       DateTime   @default(now())
  positions       Position[]
  logs            LogEntry[]
  approvals       TradeApproval[]
  @@schema("app")
}


model Position {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Chain namespace for this asset. Existing rows default to Solana because all legacy positions were created by the Solana-only engine.
  network        String    @default("solana")
  mint           String
  symbol         String
  pairAddress    String?
  status         String    @default("open") // open | closed
  simulated      Boolean   @default(true)
  entryPrice     Float
  sizeUsd        Float
  tokenAmount    Float
  feesUsd        Float     @default(0)
  highestPrice   Float
  lastPrice      Float
  compositeScore Float
  signals        String    // JSON SignalBreakdown at entry
  tier           Int       @default(1)
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  exitPrice      Float?
  pnlUsd         Float?
  pnlPct         Float?
  exitReason     String?
  entryTx        String?
  exitTx         String?
  partialsTaken  Int       @default(0)
  narrative      String?
  creator        String?   // dev/creator wallet from RugCheck (correlation cap)
  partialPnlUsd  Float     @default(0)
  partialCostUsd Float     @default(0) // cost basis already sold via partial take-profits
  partialFeesUsd Float     @default(0) // fees charged on partial take-profit fills

  @@index([accountId, status])
  @@index([accountId, mint]) // Legacy Solana lookup compatibility
  @@index([accountId, network, mint])
  @@schema("app")
}


model SignalWeight {
  name   String @id
  weight Float
  wins   Int    @default(0)
  trials Int    @default(0)
  @@schema("app")
}


model EngineState {
  id                  String    @id @default("global")
  killSwitch          Boolean   @default(false)
  killReason          String?
  killedAt            DateTime?
  priorityFeeLamports Int
  slippageBps         Int
  consecutiveFailures Int       @default(0)
  pausedUntil         DateTime?
  lastScanAt          DateTime?
  lastError           String?
  scanCount           Int       @default(0)
  candidateSnapshot   String?
  updatedAt           DateTime  @updatedAt
  @@schema("app")
}


model LogEntry {
  id        String   @id @default(cuid())
  level     String
  message   String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@schema("app")
}


model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // bug | feedback | idea
  message   String
  page      String?
  severity  String?
  createdAt DateTime @default(now())
  @@schema("app")
}


// ── Brain: persistent per-user conversation memory ─────────────────────────
model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@schema("app")
}


model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user | model
  content        String
  meta           String?      // JSON: { source, model, tools: [...], grounded }
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@schema("app")
}


// ── World events ───────────────────────────────────────────────────────────
model NewsItem {
  id          String   @id @default(cuid())
  source      String
  category    String   // crypto | macro | world | fed
  title       String
  url         String   @unique
  summary     String?
  publishedAt DateTime?
  fetchedAt   DateTime @default(now())

  @@index([publishedAt])
  @@schema("app")
}


model MarketSnapshot {
  id          String   @id @default(cuid())
  solPriceUsd Float?
  solChange24h Float?
  trending    String   // JSON array of { symbol, mint, priceChangeH1, volume24h, marketCap }
  createdAt   DateTime @default(now())
  @@schema("app")
}


model Briefing {
  id         String   @id @default(cuid())
  content    String
  source     String   // gemini | gemini-grounded | heuristic
  itemsCount Int
  sources    String?  // JSON array of grounding/source links
  createdAt  DateTime @default(now())
  @@schema("app")
}


// ── Self-reflection journal ───────────────────────────────────────────────
model JournalEntry {
  id         String   @id @default(cuid())
  kind       String   // trade | daily
  accountId  String?
  positionId String?  @unique
  dayKey     String?  // YYYY-MM-DD for daily entries (per account)
  title      String
  content    String
  source     String   // gemini | heuristic
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@unique([kind, accountId, dayKey])
  @@schema("app")
}


model CommunityMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  kind      String   @default("user") // user | audit | system
  hidden    Boolean  @default(false)
  hiddenBy  String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@schema("app")
}

/// Explicit community membership. Posting locks this row so an opt-out cannot race a new post.
model CommunityOptIn {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optedIn   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  @@schema("app")
}

/// Moderated community post. New rows stay PENDING until a moderator decision.
model CommunityPost {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           CommunityPost?  @relation("CommunityThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies          CommunityPost[] @relation("CommunityThread")
  body             String
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  moderationReason String?
  moderatedAt      DateTime?
  moderatedBy      String?
  flagged          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  events           CommunityModerationEvent[]
  reports          CommunityReport[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([parentId, createdAt])
  @@schema("app")
}

/// Append-only moderation decisions. A post's status change and its event are written together.
model CommunityModerationEvent {
  id               String        @id @default(cuid())
  postId           String
  post             CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  moderatorUserId  String
  action           String // APPROVED | REJECTED
  reason           String?
  createdAt        DateTime      @default(now())

  @@index([postId, createdAt])
  @@schema("app")
}

model CommunityReport {
  id             String        @id @default(cuid())
  postId         String
  post           CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterUserId String
  reporter       User          @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  reason         String
  createdAt      DateTime      @default(now())

  @@unique([postId, reporterUserId])
  @@index([postId])
  @@schema("app")
}


/// Owner withdrawals from the operator trading wallet (every attempt, including simulated and refused ones).
model Withdrawal {
  id              String   @id @default(cuid())
  userId          String
  toAddress       String
  lamports        String   // integer lamports as a string (avoids float/BigInt JSON issues)
  mode            String   // simulation | live
  status          String   // simulated | sent | failed | refused
  signature       String?
  closedPositions Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@schema("app")
}


/// Non-custodial live-trade suggestions. The user approves each Jupiter swap in their own wallet.
model TradeApproval {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mint           String
  symbol         String
  side           String    // buy | sell
  sizeUsd        Float
  inputMint      String
  outputMint     String
  amountRaw      String
  inAmount       String?
  outAmount      String?
  requestId      String?
  transaction    String?   // unsigned swap (base64) from Jupiter /order; never a signed tx or a key
  signature      String?   // on-chain signature after the user signs and /execute lands
  status         String    @default("pending") // pending | rejected | expired | executed | failed
  expiresAt      DateTime
  operatorFeeBps Int       @default(50)
  operatorFeeUsd Float     @default(0)
  feeUsd         Float     @default(0)
  priceImpactPct Float?
  reason         String?
  score          Float?
  error          String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([accountId, status])
  @@index([expiresAt])
  @@schema("app")
}



/// Owner profit-sweep ladder (operator wallet only). One row (id = "owner").
model ProfitSweepState {
  id                    String             @id @default("owner")
  currentBaseUsd        Float              @default(0)
  nextTargetUsd         Float              @default(50)
  totalPaidUsd          Float              @default(0)
  confirmedPayoutWallet String?
  pendingPayoutWallet   String?
  paused                Boolean            @default(false)
  pauseReason           String?
  updatedAt             DateTime           @updatedAt
  payouts               ProfitSweepPayout[]
  @@schema("app")
}


/// One rung of the owner profit-sweep ladder. rungKey is the idempotency key (e.g. sweep:t50).
model ProfitSweepPayout {
  id             String           @id @default(cuid())
  stateId        String           @default("owner")
  state          ProfitSweepState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  rungKey        String           @unique
  targetUsd      Float
  baseAfterUsd   Float
  amountUsd      Float
  amountLamports String
  toAddress      String
  memo           String?
  mode           String           // simulation | live
  status         String           // pending | sent | simulated | failed | skipped
  signature      String?
  error          String?
  createdAt      DateTime         @default(now())

  @@index([createdAt])
  @@index([status])
  @@schema("app")
}



/// Developer verification applications are not badges. Wallet signature proof and
/// independent review must be added before any public verified checkmark is issued.
model DeveloperVerification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mint        String
  wallet      String
  projectName String
  evidenceUrl String?
  statement   String
  status      String   @default("pending") // pending | needs_evidence | rejected | approved | revoked | expired
  walletProofAt DateTime?
  badgeIssuedAt DateTime?
  badgeExpiresAt DateTime?
  badgeRevokedAt DateTime?
  reviewEvents DeveloperVerificationEvent[]
  challengeHash String?
  challengeExpiresAt DateTime?
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, mint])
  @@index([status, createdAt])
  @@index([mint])
  @@schema("app")
}


model DeveloperVerificationEvent {
  id String @id @default(cuid())
  applicationId String
  application DeveloperVerification @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId String
  action String
  reason String
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
  @@schema("app")
}
